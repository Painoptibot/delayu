# Параметры экспертного стенда (копировать в .env при ручной установке без Docker).
DEBUG=true
SECRET_KEY=delayu-expert-instance-no-drm
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

POSTGRES_DB=delayu_expert
POSTGRES_USER=delayu
POSTGRES_PASSWORD=delayu_expert
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DELAYU_PLATFORM_VERSION=1.0
DELAYU_DEMO_BASE_URL=http://127.0.0.1:8000
DELAYU_PUBLIC_SITE_URL=http://127.0.0.1:8000
DELAYU_DEMO_MODE=false
DELAYU_TELEGRAM_DEMO_LOG=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
